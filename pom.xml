<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.mercadona.employee.digitaldocument</groupId>
  <artifactId>employee-back-web-digitaldocument</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>employee-back-web-digitaldocument</name>

  <!-- Provides dependency and plugin management for the given Spring Boot version -->
  <parent>
    <groupId>com.mercadona.framework.cna</groupId>
    <artifactId>fwkcna-parent</artifactId>
    <version>5.2.1</version>
  </parent>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-api-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-postgres-repository</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-kafka-consumer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-rest-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.employee.digitaldocument</groupId>
        <artifactId>employee-back-web-digitaldocument-pdf-generator</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Kafka -->
      <dependency>
        <groupId>com.mercadona.kafka.schemas.thirdparty.employee</groupId>
        <artifactId>employee</artifactId>
        <version>1.2.1</version>
      </dependency>
      <dependency>
        <groupId>com.mercadona.kafka.schemas.concepto.thirdparty.employee.employeedigitaldocument</groupId>
        <artifactId>employeedigitaldocumentv0</artifactId>
        <version>1.1.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <!-- Core application-->
    <module>application</module>
    <!-- Adapter implementations-->
    <module>driving/api-rest</module>
    <module>driving/kafka-consumer</module>
    <module>driven/postgres-repository</module>
    <module>driven/rest-client</module>
    <module>driven/pdf-generator</module>
    <!-- Runtime -->
    <module>boot</module>
  </modules>

</project>
